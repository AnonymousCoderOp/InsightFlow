# Local-only secrets. Keep this file private and never commit backend/.env.
# Create a Gemini API key from Google AI Studio and add it below to enable AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Vite origin. localhost:5174 is also allowed by the backend for port fallback.
FRONTEND_URL=http://localhost:5173

# Optional: only required when using the Adaption Model Lab's remote operations.
ADAPTION_API_KEY=

# Optional: by default the database lives at backend/insightflow.db.
# INSIGHTFLOW_DATABASE_PATH=/absolute/path/to/insightflow.db
